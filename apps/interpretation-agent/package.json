{
  "name": "@medical-crm/interpretation-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "start": "node --import tsx src/main.ts start",
    "start:self-hosted": "node --import tsx src/self-hosted-runner.ts",
    "download": "node --import tsx src/main.ts download-files",
    "probe:vad": "node --import tsx src/probe-silero.ts",
    "probe:translation": "node --import tsx src/probe-realtime-translation.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@livekit/agents": "^1.7.1",
    "@livekit/agents-plugin-silero": "^1.7.1",
    "@livekit/rtc-node": "^0.13.34",
    "tsx": "^4.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
