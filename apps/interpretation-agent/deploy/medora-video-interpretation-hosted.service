[Unit]
Description=Medora hosted video interpretation agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/medora/medical-crm-v2
EnvironmentFile=/opt/medora/medical-crm-v2/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/pnpm --filter @medical-crm/interpretation-agent start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
