{
  "name": "medical-crm-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm check:chatbot-v3-baseline-shell && turbo test",
    "test:coverage": "turbo test -- --coverage",
    "test:integration": "turbo test:integration",
    "dogfood:chatbot-v3:real-api": "pnpm exec tsx scripts/chatbot-v3-real-api-dogfood.ts",
    "test:chatbot-v3:real-api-dogfood": "pnpm exec tsx --test scripts/__tests__/chatbot-v3-real-api-dogfood.config.test.ts scripts/__tests__/chatbot-v3-real-api-dogfood.bootstrap.test.ts scripts/__tests__/chatbot-v3-real-api-dogfood.chat-runner.test.ts scripts/__tests__/chatbot-v3-real-api-dogfood.evaluator.test.ts scripts/__tests__/chatbot-v3-real-api-dogfood.reporting.test.ts",
    "check:chatbot-v3-baseline-shell": "node scripts/check-chatbot-v3-baseline-shell.mjs",
    "test:chatbot-v3-baseline-shell": "node --test scripts/check-chatbot-v3-baseline-shell.test.mjs",
    "db:pull": "pnpm --filter @medical-crm/infrastructure drizzle-kit pull",
    "db:generate": "pnpm --filter @medical-crm/infrastructure drizzle-kit generate",
    "db:migrate": "pnpm --filter @medical-crm/infrastructure db:migrate",
    "db:export:full": "node scripts/export-full-bootstrap-sql.mjs",
    "seed:faq:generate": "node scripts/generate-faq-seed.ts",
    "seed:faq:check": "node scripts/generate-faq-seed.ts --check",
    "seed:faq:import": "pnpm exec tsx scripts/import-faq-seed.ts",
    "seed:faq:evaluate": "pnpm exec tsx scripts/evaluate-faq-retrieval.ts",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
