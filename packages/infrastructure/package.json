{
  "name": "@medical-crm/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database": "./database/crm-client.ts",
    "./database/retry": "./database/transient-db-retry.ts",
    "./database/schema": "./database/schema/index.ts",
    "./supabase-main": "./supabase-main/client.ts",
    "./supabase-main/types": "./supabase-main/types.ts",
    "./supabase-main/materials": "./supabase-main/supabase-materials.repository.ts",
    "./supabase-crm": "./supabase-crm/client.ts",
    "./supabase-china": "./supabase-china/client.ts",
    "./supabase-china/types": "./supabase-china/types.ts",
    "./supabase-china/materials": "./supabase-china/china-medical-materials.repository.ts",
    "./auth": "./auth/index.ts",
    "./database/idempotency": "./database/idempotency.ts",
    "./repositories": "./database/repositories/index.ts",
    "./storage": "./storage/supabase-storage.adapter.ts",
    "./storage/r2": "./storage/r2-storage.adapter.ts",
    "./storage/s3": "./storage/s3-storage.adapter.ts",
    "./storage/registry": "./storage/storage-adapter-registry.ts",
    "./storage/routed": "./storage/routed-storage.service.ts",
    "./services": "./services/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx database/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/s3-request-presigner": "^3.1013.0",
    "@medical-crm/config": "workspace:*",
    "@medical-crm/domain": "workspace:*",
    "@medical-crm/utils": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "nodemailer": "^8.0.3",
    "openai": "^6.29.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
