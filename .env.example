# -----------------------------------------------------------------------------
# Medical CRM v2 local environment template
# Copy to ./.env, then symlink apps/api/.env -> ../../.env
# Required-on-boot values must be replaced with real dev/staging credentials.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Core URLs
ADMIN_ORIGIN=http://localhost:3002
HOSPITAL_ORIGIN=http://localhost:3003
API_URL=http://localhost:3001
CHINA_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PATIENT_APP_ORIGIN=http://localhost:5173
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3002
NEXT_PUBLIC_HOSPITAL_PORTAL_LOGIN_URL=http://localhost:3003/auth/login
NEXT_PUBLIC_CONSUMER_REGULAR_ORIGIN=https://www.medicaltourismchina.health
NEXT_PUBLIC_CONSUMER_COSMETIC_ORIGIN=https://www.medora.com
NEXT_PUBLIC_CONSUMER_HOSPITAL_PATH_TEMPLATE=/hospitals/{hospitalId}

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/medical_crm_v2
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/medical_crm_v2

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=medora
KEYCLOAK_ISSUER=http://localhost:8080/realms/medora
KEYCLOAK_CLIENT_ID=replace-with-real-keycloak-client-id
KEYCLOAK_CLIENT_SECRET=replace-with-real-keycloak-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Public auth client config
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=medora
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=replace-with-real-keycloak-client-id

# Session and internal auth
SESSION_SECRET=replace-with-a-32-char-minimum-session-secret
PATIENT_JWT_SECRET=replace-with-a-32-char-minimum-patient-jwt-secret
INTERNAL_API_SECRET=replace-with-a-32-char-minimum-internal-secret

# Main Supabase project
MAIN_SUPABASE_URL=https://replace-with-main-project.supabase.co
MAIN_SUPABASE_SERVICE_KEY=replace-with-main-project-service-role-key
MAIN_SUPABASE_ANON_KEY=replace-with-main-project-anon-key

# China medical Supabase project
CHINA_MEDICAL_SUPABASE_URL=https://replace-with-china-project.supabase.co
CHINA_MEDICAL_SUPABASE_SERVICE_KEY=replace-with-china-project-service-role-key

# CRM legacy Supabase storage
CRM_SUPABASE_URL=https://replace-with-crm-storage.supabase.co
CRM_SUPABASE_SERVICE_ROLE_KEY=replace-with-crm-storage-service-role-key

# Shared browser Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-main-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-main-project-anon-key

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_BASE_URL=
NEXT_PUBLIC_R2_BASE_URL=

# Public beauty materials bucket
R2_MATERIALS_BEAUTY_BUCKET_NAME=replace-with-public-beauty-materials-bucket
R2_MATERIALS_BEAUTY_PUBLIC_URL=https://replace-with-public-r2-domain

# AWS / S3 legacy materials
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=medchina-cloudfront
AWS_CLOUDFRONT_URL=
NEXT_PUBLIC_AWS_CLOUDFRONT_URL=

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Dify
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_API_KEY=
DIFY_CLASSIFIER_APP_API_KEY=
DIFY_DATASET_API_KEY=
DIFY_REQUEST_TIMEOUT_MS=90000
DIFY_DATASET_FAQ_COSMETIC_ID=
DIFY_DATASET_FAQ_REGULAR_ID=
DIFY_DATASET_PACKAGES_ID=

# Email, either Resend or SMTP / SES
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=
EMAIL_LOGO_URL=
MEDORA_LOGO_URL=
EMAIL_REQUEST_TIMEOUT_MS=8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
AWS_SES_SMTP_HOST=
AWS_SES_SMTP_PORT=
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASS=
AWS_SES_SMTP_SECURE=
AWS_SES_FROM_EMAIL=

# Turnstile and request edge settings
TURNSTILE_SECRET_KEY=
TRUSTED_PROXY_COUNT=1

# BabelDOC, optional document translation worker
BABELDOC_DIR=
BABELDOC_PYTHON_BIN=python3
BABELDOC_OPENAI_MODEL=gpt-4o-mini
BABELDOC_OPENAI_BASE_URL=https://api.openai.com/v1
BABELDOC_OPENAI_API_KEY=
